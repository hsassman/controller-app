{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Phone Controller",
  "version": "1.8.0",
  "identifier": "app.controller.host",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Phone Controller",
        "width": 760,
        "height": 760,
        "minWidth": 420,
        "minHeight": 520,
        "resizable": true,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Phone Controller",
    "shortDescription": "Use your phone as an Xbox controller for this PC",
    "longDescription": "Serves a touch gamepad to your phone's browser over Wi-Fi and plugs it into Windows as a real Xbox 360 controller.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "drivers/": "drivers/"
    },
    "windows": {
      "nsis": {
        "installMode": "perMachine",
        "installerHooks": "./windows/installer-hooks.nsh",
        "displayLanguageSelector": false
      }
    }
  },
  "mainBinaryName": "controller-host"
}
